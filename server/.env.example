# PostgreSQL + PostGIS connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=nearaid
PGUSER=postgres
PGPASSWORD=change-me

# JWT secret for admin login - use a long random string
JWT_SECRET=change-me-to-a-long-random-string

# Seed-only: initial admin account created by db/seed.js.
# Set a strong unique value BEFORE seeding; to change it later, re-seed or update the hash in the database.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin

# Server port
PORT=5000

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173

# Note: quote any value that contains # or spaces - dotenv strips unquoted
# trailing comments, e.g. SEED_ADMIN_PASSWORD="abc#123"
